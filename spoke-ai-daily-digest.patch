+    await runDigestSweep(FRI_14_UTC);
+    const second = await runDigestSweep(new Date("2026-09-04T15:00:00Z"));
+    expect(second.sent).toBe(0);
+    expect(sendEmailMock).toHaveBeenCalledTimes(1);
