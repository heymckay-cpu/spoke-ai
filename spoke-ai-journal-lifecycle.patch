+  return customFetch<AssignPositionResult>(getAssignPositionUrl(id), {
+    ...options,
+    method: "POST",
+    headers: { "Content-Type": "application/json", ...options?.headers },
+    body: JSON.stringify(assignPositionInput),
+  });
+};
